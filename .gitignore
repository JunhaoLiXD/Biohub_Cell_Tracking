# ===== Data (lives on Kaggle, never commit) =====
*.zarr/
*.geff/
data/
train/
test/
*.tif
*.tiff

# ===== Model weights / checkpoints / large artifacts =====
*.pt
*.pth
*.ckpt
*.onnx
wheels/
*.whl

# ===== Generated outputs =====
submission.csv
history.csv
history.json
# local training-history / result artifacts (e.g. v1_history.csv)
results/
# heavy notebook run-dumps (debug artifacts)
*-output.ipynb
outputs/
runs/
logs/

# ===== Remote experiment artifacts (large, re-downloadable from Kaggle) =====
# The experiment RECORDS and immutable snapshots (small text/JSON/notebooks) ARE
# version-controlled so provenance has an off-site backup. The multi-hundred-MB
# collected Kaggle outputs and the ephemeral kernel-staging dirs are not.
experiments/**/artifacts/
experiments/**/kaggle_kernel/
experiments/**/kaggle_kernel_retry_*/

# ===== Jupyter =====
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# ===== Python =====
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.env
.env.*
.ipynb_checkpoints

# ===== OS / IDE =====
.DS_Store
Thumbs.db
.vscode/
.idea/
.pytest_cache/
.pytest_tmp_*/

# ===== Local credentials and private workspace (never share) =====
.kaggle/
.private/
.claude/

# ===== Third-party reference material (not ours to redistribute) =====
references/
external_baselines/

# ===== Controller runtime lock =====
.controller.lock
